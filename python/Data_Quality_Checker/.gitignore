# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Logs
logs/
*.log

# Generated reports & charts (keep the folder structure via .gitkeep,
# but don't commit generated artifacts from every local run)
reports/*
!reports/.gitkeep
!reports/sample_reports/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Type checking
.mypy_cache/
.ruff_cache/
